# Vercel Blob automatically creates this value when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# GitHub OAuth App credentials. Keep the client secret server-side.
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me

# Generate at least 32 random characters. This signs the owner session cookie.
AUTH_SECRET=replace_with_a_long_random_secret

# Production OAuth callback registered in the GitHub OAuth App.
GITHUB_OAUTH_CALLBACK_URL=https://seadream.vercel.app/api/auth/callback
