---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import PostTOC from "../components/widget/PostTOC.astro";
import { siteConfig } from "../config";
import {
    BANNER_HEIGHT,
    BANNER_HEIGHT_EXTEND,
    BANNER_HEIGHT_HOME,
    MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
    title?: string;
    banner?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    headings?: MarkdownHeading[];
    reader?: boolean;
}

const {
    title,
    banner,
    description,
    lang,
    setOGTypeArticle,
    headings = [],
    reader = false,
} = Astro.props;
const hasBannerCredit =
    siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
    ? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
    : "6.5rem";

const bannerEnabled = siteConfig.banner.enable;

const bannerOffsetByPosition = {
    top: `${BANNER_HEIGHT_EXTEND}vh`,
    center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
    bottom: "0",
};
const bannerOffset =
    bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<Layout
    title={title}
    banner={banner}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
>
    <!-- Navbar -->
    <slot slot="head" name="head" />
    <div
        id="top-row"
        class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto"
        class:list={[""]}
    >
        <div
            id="navbar-wrapper"
            class="pointer-events-auto sticky top-4 transition-all"
        >
            <Navbar />
        </div>
    </div>

    <!-- Banner -->
    {
        siteConfig.banner.enable && (
            <div
                id="banner-wrapper"
                class={`absolute z-10 w-full transition duration-700 overflow-hidden`}
                style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
            >
                <ImageWrapper
                    id="banner"
                    alt="Banner image of the blog"
                    class:list={[
                        "object-cover h-full transition duration-700 opacity-0 scale-105",
                    ]}
                    src={siteConfig.banner.src}
                    position={siteConfig.banner.position}
                />
            </div>
        )
    }

    <!-- Main content -->
    <div
        id="main-content"
        class="absolute w-full z-30 pointer-events-none"
        style={`top: ${mainPanelTop}`}
    >
        <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
        <div
            class:list={[
                "relative mx-auto pointer-events-auto",
                reader ? "max-w-[100rem]" : "max-w-[var(--page-width)]",
            ]}
        >
            <div
                id="main-grid"
                class:list={[
                    "transition duration-700 w-full left-0 right-0 grid mx-auto gap-4 px-0 md:px-4",
                    reader
                        ? "grid-cols-1 grid-rows-[auto_auto]"
                        : "grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]",
                ]}
            >
                <!-- Banner image credit -->
                {
                    hasBannerCredit && (
                        <a
                            href={siteConfig.banner.credit.url}
                            id="banner-credit"
                            target="_blank"
                            rel="noopener"
                            aria-label="Visit image source"
                            class:list={[
                                "group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                    "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9",
                                {
                                    "hover:pr-9 active:bg-black/80":
                                        hasBannerLink,
                                },
                            ]}
                        >
                            <Icon
                                class="text-white/75 text-[1.25rem] mr-1"
                                name="material-symbols:copyright-outline-rounded"
                            />
                            <div class="text-white/75 text-xs">
                                {siteConfig.banner.credit.text}
                            </div>
                            <Icon
                                class:list={[
                                    "transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                                    {
                                        "group-hover:opacity-100":
                                            hasBannerLink,
                                    },
                                ]}
                                name="fa6-solid:arrow-up-right-from-square"
                            />
                        </a>
                    )
                }

                {
                    !reader && (
                        <SideBar
                            class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation"
                        />
                    )
                }

                <main
                    id="swup-container"
                    class:list={[
                        "transition-swup-fade",
                        reader
                            ? "col-span-1 overflow-visible"
                            : "col-span-2 overflow-hidden lg:col-span-1",
                    ]}
                >
                    <div id="content-wrapper" class="onload-animation">
                        <!-- the overflow-hidden here prevent long text break the layout-->
                        <!-- make id different from windows.swup global property -->
                        <slot />
                        <div
                            class="footer col-span-2 onload-animation hidden lg:block"
                        >
                            <Footer />
                        </div>
                    </div>
                </main>

                <div
                    class:list={[
                        "footer onload-animation block lg:hidden",
                        reader ? "col-span-1" : "col-span-2",
                    ]}
                >
                    <Footer />
                </div>
            </div>

            <BackToTop />
        </div>
    </div>

    <!-- #toc is a Swup container and must exist on every page. -->
    <div class="absolute w-full z-40 pointer-events-none">
        <div id="toc" class="transition-swup-fade">
            {siteConfig.toc.enable && <PostTOC headings={headings} />}
        </div>
    </div>

    <style
        is:global
        define:vars={{
            bannerOffset,
            "banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
            "banner-height": `${BANNER_HEIGHT}vh`,
        }}
    >
        @tailwind components;
        @layer components {
            .enable-banner.is-home #banner-wrapper {
                @apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)];
            }

            .enable-banner #banner-wrapper {
                @apply h-[var(--banner-height-home)];
            }

            .enable-banner.is-home #banner {
                @apply h-[var(--banner-height-home)] translate-y-0;
            }

            .enable-banner #banner {
                @apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)];
            }

            .enable-banner.is-home #main-grid {
                @apply translate-y-[var(--banner-height-extend)];
            }

            .enable-banner #top-row {
                @apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300;
            }

            .enable-banner.is-home #sidebar-sticky {
                @apply top-[calc(1rem_-_var(--banner-height-extend))];
            }

            .navbar-hidden {
                @apply opacity-0 -translate-y-16;
            }
        }
    </style>

    <script is:inline define:vars={{ bannerEnabled }}>
        function showBanner() {
            if (!bannerEnabled) return;

            const banner = document.getElementById("banner");
            if (!banner) {
                console.error("Banner element not found");
                return;
            }

            banner.classList.remove("opacity-0", "scale-105");
        }

        showBanner();
    </script>
</Layout>
