---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const nameFlags = [
    {
        src: url("/flags/argentina.svg"),
        alt: "阿根廷国旗",
    },
    {
        src: url("/flags/japan.svg"),
        alt: "日本国旗",
    },
];
---

<div class="profile-card card-base p-3">
    <div
        class="profile-avatar-orbit relative mx-auto mb-5 mt-3 h-44 w-44 sm:h-48 sm:w-48 lg:h-[13rem] lg:w-[13rem]"
    >
        <span class="profile-avatar-loop" aria-hidden="true"></span>
        <span class="profile-avatar-loop" aria-hidden="true"></span>
        <span class="profile-avatar-loop" aria-hidden="true"></span>
        <span class="profile-avatar-loop" aria-hidden="true"></span>

        <a
            aria-label="Go to About Page"
            href={url("/about/")}
            class="profile-avatar-link group absolute inset-0 z-10 block overflow-hidden rounded-full active:scale-95"
        >
            <div
                class="pointer-events-none absolute inset-0 z-50 flex items-center justify-center rounded-full transition group-hover:bg-black/30 group-active:bg-black/50"
            >
                <Icon
                    name="fa6-regular:address-card"
                    class="scale-90 text-5xl text-white opacity-0 transition group-hover:scale-100 group-hover:opacity-100"
                />
            </div>
            <ImageWrapper
                src={config.avatar || ""}
                alt="Profile Image of the Author"
                class="h-full w-full rounded-full"
            />
        </a>
    </div>
    <div class="px-2">
        <div
            class="mb-1 flex items-center justify-center gap-2 text-center font-bold text-xl dark:text-neutral-50 transition"
        >
            <img
                src={nameFlags[0].src}
                alt={nameFlags[0].alt}
                width="24"
                height="16"
                class="h-4 w-6 flex-none rounded-[0.125rem] object-cover shadow-sm shadow-black/15"
                loading="lazy"
            />
            <span class="min-w-0 truncate">{config.name}</span>
            <img
                src={nameFlags[1].src}
                alt={nameFlags[1].alt}
                width="24"
                height="16"
                class="h-4 w-6 flex-none rounded-[0.125rem] object-cover shadow-sm shadow-black/15"
                loading="lazy"
            />
        </div>
        <div
            class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"
        >
        </div>
        <div class="text-center text-neutral-400 mb-2.5 transition">
            {config.bio}
        </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {
                config.links.length > 1 &&
                    config.links.map((item) => (
                        <a
                            rel="me"
                            aria-label={item.name}
                            href={item.url}
                            target="_blank"
                            class="btn-regular rounded-lg h-10 w-10 active:scale-90"
                        >
                            <Icon name={item.icon} class="text-[1.5rem]" />
                        </a>
                    ))
            }
            {
                config.links.length == 1 && (
                    <a
                        rel="me"
                        aria-label={config.links[0].name}
                        href={config.links[0].url}
                        target="_blank"
                        class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95"
                    >
                        <Icon
                            name={config.links[0].icon}
                            class="text-[1.5rem]"
                        />
                        {config.links[0].name}
                    </a>
                )
            }
        </div>
    </div>
</div>

<style>
    .profile-avatar-orbit {
        isolation: isolate;
    }

    .profile-card {
        overflow: visible;
    }

    .profile-avatar-loop {
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: 38% 62% 63% 37% / 41% 44% 56% 59%;
        background: var(--primary);
        opacity: var(--loop-opacity);
        pointer-events: none;
        transform-origin: center;
        animation: profile-avatar-orbit var(--loop-duration) linear infinite;
        will-change: transform;
    }

    .profile-avatar-loop:nth-of-type(1) {
        --loop-angle: 30deg;
        --loop-duration: 10s;
        --loop-opacity: 0.2;
    }

    .profile-avatar-loop:nth-of-type(2) {
        --loop-angle: 60deg;
        --loop-duration: 15s;
        --loop-opacity: 0.32;
    }

    .profile-avatar-loop:nth-of-type(3) {
        --loop-angle: 90deg;
        --loop-duration: 10s;
        --loop-opacity: 0.2;
    }

    .profile-avatar-loop:nth-of-type(4) {
        --loop-angle: 120deg;
        --loop-duration: 15s;
        --loop-opacity: 0.32;
    }

    .profile-avatar-link {
        box-shadow:
            0 0 0 3px var(--card-bg),
            0 12px 28px rgb(15 23 42 / 18%);
        transition:
            transform 200ms ease,
            box-shadow 300ms ease;
    }

    .profile-avatar-orbit:hover .profile-avatar-link {
        box-shadow:
            0 0 0 3px var(--card-bg),
            0 16px 34px oklch(0.5 0.12 var(--hue) / 24%);
    }

    @keyframes profile-avatar-orbit {
        from {
            transform: rotate(var(--loop-angle));
        }

        to {
            transform: rotate(calc(var(--loop-angle) + 360deg));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .profile-avatar-loop {
            animation: none;
            transform: rotate(var(--loop-angle));
        }
    }
</style>
